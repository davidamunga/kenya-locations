{
  "name": "kenya-locations-react",
  "version": "0.10.4",
  "description": "React hooks for kenya-locations — counties, constituencies, wards, localities, areas and fuzzy search",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "author": "David Amunga <https://davidamunga.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/davidamunga/kenya-locations.git"
  },
  "bugs": {
    "url": "https://github.com/davidamunga/kenya-locations/issues"
  },
  "homepage": "https://kenya-locations.web.app",
  "keywords": [
    "kenya",
    "counties",
    "constituencies",
    "wards",
    "react",
    "hooks",
    "locations"
  ],
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --p ./tsconfig.json && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --no-warn-ignored",
    "format": "prettier --write ."
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "dependencies": {
    "kenya-locations": "workspace:*"
  },
  "devDependencies": {
    "@eslint/js": "^9.27.0",
    "@testing-library/react": "^16.2.0",
    "@types/react": "^19.0.8",
    "@typescript-eslint/eslint-plugin": "^8.32.1",
    "@typescript-eslint/parser": "^8.32.1",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.26.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^26.0.0",
    "react": "^19.0.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vite-plugin-dts": "^4.5.3",
    "vitest": "^1.3.1"
  }
}
