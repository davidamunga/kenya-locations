{
  "name": "kenya-locations-monorepo",
  "private": true,
  "type": "module",
  "description": "Monorepo for kenya-locations — shared data and platform libraries",
  "scripts": {
    "dev": "pnpm --filter kenya-locations-web dev",
    "start": "pnpm --filter kenya-locations-web start",
    "web:build": "pnpm --filter kenya-locations-web build",
    "web:preview": "pnpm --filter kenya-locations-web preview",
    "web:deploy": "pnpm web:build && npx firebase-tools deploy --only hosting --config apps/web/firebase.json --project kenya-locations",
    "validate": "node scripts/validate-data.js",
    "build": "pnpm --filter kenya-locations build",
    "test": "pnpm --filter kenya-locations test",
    "lint": "pnpm --filter kenya-locations lint",
    "commitlint": "commitlint --edit",
    "commitlint:last": "commitlint --last --verbose",
    "prepare": "husky",
    "changeset": "changeset",
    "changeset:version": "changeset version && node scripts/sync-kotlin-version.js && node scripts/sync-swift-version.js && node scripts/sync-dart-version.js && node scripts/sync-php-version.js",
    "changeset:check": "node scripts/check-changeset.js",
    "changeset:check:test": "node --test scripts/check-changeset.test.js",
    "changeset:publish:js": "pnpm --filter kenya-locations changeset:publish"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.5.1",
    "@changesets/cli": "^2.29.7",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "husky": "^9.1.7",
    "lint-staged": "^16.0.0"
  },
  "packageManager": "pnpm@10.10.0+sha512.d615db246fe70f25dcfea6d8d73dee782ce23e2245e3c4f6f888249fb568149318637dca73c2c5c8ef2a4ca0d5657fb9567188bfab47f566d1ee6ce987815c39",
  "lint-staged": {
    "data/*.json": [
      "node scripts/validate-staged.js"
    ]
  }
}
